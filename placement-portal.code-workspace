{
  "folders": [
    {
      "name": "🎓 Placement Portal - Root",
      "path": "."
    },
    {
      "name": "📱 Mobile App",
      "path": "./mobile"
    },
    {
      "name": "🌐 Flask Backend",
      "path": "."
    }
  ],
  "settings": {
    "editor.formatOnSave": true,
    "editor.defaultFormatter": "esbenp.prettier-vscode",
    "files.exclude": {
      "**/.git": true,
      "**/__pycache__": true,
      "**/*.pyc": true,
      "**/node_modules": true,
      "**/.DS_Store": true
    },
    "python.linting.enabled": true,
    "python.linting.pylintEnabled": true,
    "python.formatting.provider": "black",
    "[javascript]": {
      "editor.defaultFormatter": "esbenp.prettier-vscode"
    },
    "[python]": {
      "editor.defaultFormatter": "ms-python.black-formatter"
    }
  },
  "extensions": {
    "recommendations": [
      "ms-python.python",
      "ms-python.vscode-pylance",
      "esbenp.prettier-vscode",
      "dbaeumer.vscode-eslint",
      "msjsdiag.vscode-react-native",
      "ms-vscode.vscode-typescript-next"
    ]
  },
  "launch": {
    "version": "0.2.0",
    "configurations": [
      {
        "name": "Flask: App",
        "type": "python",
        "request": "launch",
        "module": "flask",
        "env": {
          "FLASK_APP": "app.py",
          "FLASK_DEBUG": "1"
        },
        "args": ["run", "--no-debugger", "--no-reload"],
        "jinja": true,
        "justMyCode": true
      },
      {
        "name": "React Native: Android",
        "cwd": "${workspaceFolder}/mobile",
        "type": "reactnative",
        "request": "launch",
        "platform": "android"
      },
      {
        "name": "React Native: iOS",
        "cwd": "${workspaceFolder}/mobile",
        "type": "reactnative",
        "request": "launch",
        "platform": "ios"
      }
    ]
  }
}
